# Dev / shared (optional). For local `npm run dev` copy to `.env.local`.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: public HTTPS URLs to the Windows installers (e.g. Supabase Storage).
# Needed for production if installers are not in git — see public/INSTALLER_README.txt.
# Vercel: set these in Project → Settings → Environment Variables, redeploy.
# VITE_RESTAURANT_POS_EXE_URL=https://.../VyntexPOSSetup.exe
# VITE_RESTAURANT_POS_EXE_URL_X64=https://.../VyntexPOSSetup.exe
# VITE_RESTAURANT_POS_EXE_URL_ARM64=https://.../VyntexPOSSetup-arm64.exe
