# Dev / shared (optional). For local `npm run dev` copy to `.env.local`.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Dev-only: force POS UI/plan gates to a tier without changing Supabase (starter | professional | enterprise).
# Or use: npm run dev:pos-plan:starter (Vite + Electron desktop, same as dev:desktop with a forced plan)
# VITE_POS_DEV_PLAN=starter

# Optional: public HTTPS URLs to the Windows installers (e.g. Supabase Storage).
# Needed for production if installers are not in git — see public/INSTALLER_README.txt.
# Vercel: set these in Project → Settings → Environment Variables, redeploy.
# VITE_RESTAURANT_POS_EXE_URL=https://.../RestaurantPOSSetup.exe
# VITE_RESTAURANT_POS_EXE_URL_X64=https://.../RestaurantPOSSetup.exe
# VITE_RESTAURANT_POS_EXE_URL_ARM64=https://.../RestaurantPOSSetup-arm64.exe

# Platform admin panel (comma-separated; must also exist in Supabase for revenue KPIs)
# VITE_PLATFORM_ADMIN_EMAILS=you@company.com
# After migrations 021–023, in SQL Editor (once per email):
#   insert into public.platform_admin_emails (email) values ('you@company.com') on conflict do nothing;

# Paddle (pricing checkout + admin revenue webhooks)
# VITE_PADDLE_CLIENT_TOKEN=
# VITE_PADDLE_ENV=sandbox
# VITE_PADDLE_STARTER_MONTHLY_PRICE_ID=
# … (other VITE_PADDLE_* price IDs — see src/pages/pricing/page.tsx)
# Supabase: run migrations 020–022, then deploy edge function:
#   supabase functions deploy paddle-webhook --no-verify-jwt
# Edge Function secrets (Dashboard → Edge Functions → paddle-webhook):
# PADDLE_WEBHOOK_SECRET=   (Paddle → Developer tools → Notifications)
# PADDLE_*_PRICE_ID=       (same price IDs for plan mapping in webhook)
