# Required for packaged Windows POS (`npm run dist:win`) so the .exe talks to your project.
# Copy this file to `.env.production.local` (git-ignored) and replace with real values.
# Same place as dev: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
