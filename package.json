{
  "name": "vyntex-pos",
  "private": true,
  "version": "1.0.85",
  "description": "Vyntex POS — restaurant point of sale (web, desktop, companion apps). Windows installer targets laptops, touch PCs, Intel x64 and ARM64.",
  "author": "Vyntex",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:restaurant-starter": "concurrently -k \"cross-env VITE_POS_DEV_PLAN=starter vite --host 0.0.0.0 --port 5173 --strictPort\" \"npm:electron\"",
    "dev:restaurant-professional": "concurrently -k \"cross-env VITE_POS_DEV_PLAN=professional vite --host 0.0.0.0 --port 5173 --strictPort\" \"npm:electron\"",
    "dev:restaurant-enterprise": "concurrently -k \"cross-env VITE_POS_DEV_PLAN=enterprise vite --host 0.0.0.0 --port 5173 --strictPort\" \"npm:electron\"",
    "dev:restaurant-enterprice": "npm run dev:restaurant-enterprise",
    "dev:pos-plan:starter": "npm run dev:restaurant-starter",
    "dev:pos-plan:professional": "npm run dev:restaurant-professional",
    "dev:pos-plan:enterprise": "npm run dev:restaurant-enterprise",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:phone": "vite --host 0.0.0.0 --port 5173 --strictPort --open /phone.html",
    "electron": "wait-on http://127.0.0.1:5173 -t 120000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:electron\"",
    "dev:restaurant": "npm run dev:desktop",
    "dev:ios": "npm run dev:phone",
    "dev:android": "npm run dev:phone",
    "start:desktop": "electron .",
    "preview": "vite preview",
    "prebuild:web": "node scripts/sync-public-build-meta.mjs && node scripts/ensure-public-installer-sync.mjs && node scripts/ensure-vite-supabase-env.mjs",
    "build:web": "vite build",
    "build:electron": "npm run prebuild:web && cross-env VITE_RELATIVE_BASE=true vite build",
    "build:phone:web": "cross-env VITE_PHONE_STORE_BUILD=true vite build && node scripts/prepare-capacitor-phone-web.mjs",
    "cap:copy": "npm run build:phone:web && npx cap copy",
    "cap:sync": "npm run build:phone:web && npx cap sync",
    "cap:open:android": "npm run cap:sync && npx cap open android",
    "cap:open:ios": "npm run cap:sync && npx cap open ios",
    "dist:android:aab": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "dist:ios:archive": "npm run cap:sync && npx cap open ios",
    "build": "npm run build:web",
    "build:desktop": "npm run build:electron && electron-builder",
    "build:desktop:full": "npm run clean:electron-release && npm run build:electron && electron-builder",
    "clean:electron-release": "node scripts/clean-electron-release.mjs",
    "predist:win": "node scripts/free-packaging-locks.mjs",
    "dist:win": "npm run build:electron && electron-builder --win nsis",
    "dist:win:fresh": "npm run build:electron && electron-builder --win nsis --config.directories.output=release-eb-staging && cross-env RELEASE_DIR=release-eb-staging node scripts/copy-windows-installers-to-public.mjs",
    "dist:win:full": "npm run update:restaurant-pos",
    "update:restaurant-pos": "node scripts/update-pos-product.mjs restaurant",
    "update:fitness-pos": "node scripts/update-pos-product.mjs fitness",
    "update:bar-pos": "node scripts/update-pos-product.mjs bar",
    "update:hotel-pos": "node scripts/update-pos-product.mjs hotel",
    "pos-update": "node scripts/update-pos-product.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "deploy:vercel:git": "cross-env VERCEL_DEPLOY=git node scripts/deploy-vercel.mjs",
    "dist:win:skip-clean": "npm run dist:win",
    "postdist:win": "node scripts/copy-windows-installers-to-public.mjs && node scripts/sync-public-build-meta.mjs",
    "copy-installers": "node scripts/copy-windows-installers-to-public.mjs && node scripts/sync-public-build-meta.mjs",
    "lint": "eslint .",
    "prettier-fix": "prettier --write .",
    "prettier-check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@convex-dev/eslint-plugin": "^1.2.1",
    "@eslint/js": "^9.39.4",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.102.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@usehercules/auth": "^1.0.40",
    "@usehercules/eslint-plugin": "^1.0.40",
    "@usehercules/vite": "^1.0.40",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "convex": "^1.34.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "i18next": "^26.0.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^3.5.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^17.0.2",
    "react-oidc-context": "^3.3.1",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.13.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "use-debounce": "^10.1.0",
    "vaul": "^1.1.2",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.vyntex.restaurantpos",
    "productName": "Vyntex POS",
    "asar": true,
    "asarUnpack": [
      "electron/icon.ico"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.exe",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "RestaurantPOSSetup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vyntex POS ${version}",
      "uninstallDisplayName": "${productName} ${version}"
    }
  }
}
