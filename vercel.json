{
  "buildCommand": "npm run build:web",
  "headers": [
    {
      "source": "/build-meta.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dashboard/restaurant_pos",
      "destination": "/dashboard/restaurant-pos",
      "permanent": true
    },
    {
      "source": "/dashboard/restaurant_pos/:path*",
      "destination": "/dashboard/restaurant-pos/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/RestaurantPOSSetup-:version-x64.exe",
      "destination": "/RestaurantPOSSetup.exe"
    },
    {
      "source": "/RestaurantPOSSetup-:version-arm64.exe",
      "destination": "/RestaurantPOSSetup-arm64.exe"
    },
    {
      "source": "/VyntexPOSSetup.exe",
      "destination": "/api/installer-x64"
    },
    {
      "source": "/VyntexPOSSetup-arm64.exe",
      "destination": "/api/installer-arm64"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
